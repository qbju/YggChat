<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of YggChat goes to cloud backup or device-to-device
     transfer. The data dir holds the Yggdrasil identity key, the chat store and
     the UI key; a restored copy would run the same key on two devices (move
     the account with 端末移行 instead). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
